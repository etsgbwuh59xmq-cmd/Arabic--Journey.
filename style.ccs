body {
    font-family: Arial, sans-serif;
    background-color: #f4f7f6;
    margin: 0;
    padding: 0;
    color: #333;
}

header {
    background-color: #2c3e50;
    color: white;
    text-align: center;
    padding: 1rem;
}

.container {
    max-width: 800px;
    margin: 20px auto;
    padding: 0 15px;
}

.card {
    background: white;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.badge {
    background-color: #e74c3c;
    color: white;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 1.2rem;
    font-weight: bold;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
    gap: 10px;
    margin-top: 15px;
}

.letter-btn {
    background-color: #3498db;
    color: white;
    border: none;
    padding: 15px;
    font-size: 1.5rem;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.1s, background-color 0.2s;
}

.letter-btn:hover {
    background-color: #2980b9;
    transform: scale(1.05);
}

.harakat-controls {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

select {
    font-size: 1.2rem;
    padding: 8px;
    border-radius: 5px;
}

.harakat-buttons button {
    font-size: 1.1rem;
    padding: 8px 12px;
    margin: 2px;
    background-color: #2ecc71;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.harakat-buttons button:hover {
    background-color: #27ae60;
}

.display-box {
    font-size: 4rem;
    text-align: center;
    padding: 20px;
    background-color: #ecf0f1;
    border-radius: 8px;
}